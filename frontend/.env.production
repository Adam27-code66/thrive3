# Production API URL — replace this with your actual backend Vercel URL after deploying the backend.
# Example: https://thrive3-backend.vercel.app
#
# IMPORTANT: You must also add this as an Environment Variable in the Vercel dashboard
# for the frontend project (Settings → Environment Variables → VITE_API_BASE_URL).
# Vercel does NOT read .env.production at build time automatically unless you add it.
VITE_API_BASE_URL=https://backend-green-seven-88.vercel.app/api
